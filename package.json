{
  "name": "mysdk",
  "version": "0.1.2",
  "description": "SDK expérimental de gestion d'utilisateurs sans appels d'API",
  "keywords": ["SDK", "users", "publication", "experimental"],
  "author": "Vincent Duval",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "test": "node test/utilisation.js",
    "dev": "tsx watch src/index.ts", 
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
